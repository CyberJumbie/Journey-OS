NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Embeddings ─────────────────────────────────────────────────────────────
# Which providers to run at INGEST time (comma-separated list)
# Both = store both embedding columns per chunk for 6-month comparison
EMBEDDING_PROVIDERS=voyage,openai

# Which provider to use at SEARCH time (switch to compare without re-ingesting)
# Options: voyage | openai
EMBEDDING_SEARCH_PROVIDER=voyage

VOYAGE_API_KEY=pa-...         # voyage-large-2, 1024-dim
OPENAI_API_KEY=sk-...         # text-embedding-3-small, 1536-dim

# ── Optional ───────────────────────────────────────────────────────────────
LLAMAPARSE_API_KEY=llx-...    # optional — enables Markdown-quality PDF extraction
PORT=3001
NODE_ENV=development

# ── Phase 2: Inngest ──────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Phase 3: UMLS ─────────────────────────────────────────────────────────────
UMLS_API_KEY=

# ── Phase 4: MIP Solver ───────────────────────────────────────────────────────
MIP_SOLVER_URL=http://localhost:8001
