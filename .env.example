# ============================================================
# JOURNEY OS — MASTER ENV EXAMPLE
# Copy to .env.local (gitignored) and fill in real values.
# Each sub-package also has its own .env.example.
# ============================================================

# --- BACKEND (backend/.env.local) ---

# Neo4j Aura
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
# NOTE: NEO4J_USER not NEO4J_USERNAME — critical, breaks silently if wrong
NEO4J_PASSWORD=your-password-here

# Supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# AI Services
ANTHROPIC_API_KEY=sk-ant-api03-...

# Embeddings — dual-provider for 6-month retrieval quality comparison
# Both providers embed at ingest time (each chunk gets two vector columns populated).
# Switch EMBEDDING_SEARCH_PROVIDER to change which column is used at query time — no re-ingest needed.
EMBEDDING_PROVIDERS=voyage,openai          # comma-separated: which providers run at INGEST time
EMBEDDING_SEARCH_PROVIDER=voyage           # which provider runs at SEARCH time: voyage | openai
VOYAGE_API_KEY=pa-...                      # voyage-large-2, 1024-dim, batch max 128
OPENAI_API_KEY=sk-...                      # text-embedding-3-small, 1536-dim, batch max 100
LLAMAPARSE_API_KEY=llx-...                 # Optional — used by PdfParserFactory if present

# Server
PORT=3001
NODE_ENV=development

# Python service URLs (Phase 4+, optional in Phase 1)
PDF_PARSER_SERVICE_URL=http://localhost:8003   # Optional — fallback if LlamaParse fails
MIP_SOLVER_SERVICE_URL=http://localhost:8001   # Phase 4 only
IRT_SERVICE_URL=http://localhost:8002          # Phase 5 only

# --- FRONTEND (frontend/.env.local) ---

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- SEEDER (seeder/.env or seeder/.env.local) ---
# Uses the same NEO4J_* vars above

# ── Phase 2: Inngest ──────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=           # from Inngest dashboard (inngest.com)
INNGEST_SIGNING_KEY=         # webhook signature verification

# ── Phase 3: UMLS LOD Enrichment ─────────────────────────────────────────────
UMLS_API_KEY=              # free at https://uts.nlm.nih.gov/uts/signup-login

# ── Phase 4: MIP Solver ───────────────────────────────────────────────────────
MIP_SOLVER_URL=http://localhost:8001
