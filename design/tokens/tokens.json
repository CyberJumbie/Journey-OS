{
  "_comment": "Journey OS Design Tokens — synced from Figma Variables. Source: DESIGN_SYSTEM.md",
  "_workflow": "When Figma Variables change: update this file → sync to apps/web/src/styles/globals.css",

  "color": {
    "surfaces": {
      "cream":     { "value": "#f5f3ef", "usage": "bg-cream — page background" },
      "parchment": { "value": "#faf9f6", "usage": "bg-parchment — cards, sidebar" },
      "white":     { "value": "#ffffff", "usage": "bg-white — reading areas, modals" },
      "navy":      { "value": "#002c76", "usage": "bg-navy — hero, max 1 per page (inverted)" }
    },
    "brand": {
      "blue":      { "value": "#2b71b9", "usage": "interactive elements, links" },
      "green":     { "value": "#69a338", "usage": "success, approved status" },
      "red":       { "value": "#d32f2f", "usage": "error, rejected status" },
      "amber":     { "value": "#f59e0b", "usage": "warning, pending status" }
    },
    "neutral": {
      "gray-600":  { "value": "#4b5563", "usage": "secondary text" },
      "gray-300":  { "value": "#d1d5db", "usage": "borders, dividers" }
    }
  },

  "typography": {
    "heading": { "family": "Lora", "weight": "600",       "token": "font-heading" },
    "body":    { "family": "Source Sans 3", "weight": "400", "token": "font-body" },
    "label":   { "family": "DM Mono", "weight": "400", "style": "uppercase", "token": "font-label" }
  },

  "layout": {
    "sidebar-collapsed": "72px",
    "sidebar-expanded":  "240px",
    "content-max-width": "1200px"
  }
}
